# Flask session encryption key. Change this before sharing or deploying.
SECRET_KEY=replace-this-with-a-long-random-string

# Optional. Used only when the first admin account is created.
# If unset, the default is admin123. Change it after first login.
ADMIN_PASSWORD=admin123

# Optional. Needed for the AI book recommendation chat.
# Get a key from Anthropic and leave this empty if you only want to run the rest of the app.
ANTHROPIC_API_KEY=
